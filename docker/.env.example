# Address
# The name or IP address people type to open Shelfy, like shelfy.example.com, shelfy.home.arpa or 192.168.1.20
FRONTEND_DOMAIN=shelfy.example.com
# Optional separate name for the API, like api.shelfy.example.com
# Leave empty to serve the API from FRONTEND_DOMAIN under /api
API_DOMAIN=
# How Shelfy gets HTTPS
# public: free Let's Encrypt certificate, ports 80 and 443 must be open to the Internet
# internal: Caddy makes its own certificate, for a home network or a VPN
# off: plain HTTP, when your own proxy or tunnel already handles HTTPS
TLS_MODE=public
# Ports used on this machine
# Change them if 80 or 443 is already taken, for example by your NAS
HTTP_PORT=80
HTTPS_PORT=443
# With TLS_MODE=off only: the address Shelfy listens on
# Set 127.0.0.1 when your proxy or tunnel runs on this machine, so nobody can skip it
# Leave empty to listen on every address, when your proxy runs on another machine
HTTP_BIND=
# Full web address of Shelfy, like https://shelfy.example.com
# Leave empty to build it from FRONTEND_DOMAIN
# Required when TLS_MODE=off or FRONTEND_HOSTING=external
FRONTEND_URL=
# Where the website runs
# bundled: this server runs both the website and the API
# external: this server runs only the API on API_DOMAIN, the website lives at FRONTEND_URL
FRONTEND_HOSTING=bundled

# Federation
# Lets people on other Shelfy instances and on the Fediverse (Mastodon and others) follow your users
# Nothing is sent anywhere until someone follows someone
# Defaults to true with TLS_MODE=public and false otherwise, and cannot work with TLS_MODE=internal
# Set it to true with TLS_MODE=off only if your proxy or tunnel is reachable from the Internet
# FEDERATION_ENABLED=true
# open: talk to every instance, allowlist: only to instances an admin approves
# FEDERATION_MODE=open
# Emails of the accounts allowed to block instances and read reports from other instances, comma separated
# An account only counts as admin once its email is confirmed, by the link Shelfy emails
# Without an email server, confirm it from this machine: bash docker/verify-email.sh alice@example.com
# FEDERATION_ADMINS=alice@example.com
# true: other servers must sign their requests to read profiles, outboxes and posts, like Mastodon's secure mode
# Servers that do not sign cannot read your profiles, so leave it off unless you need it
# FEDERATION_AUTHORIZED_FETCH=false
# The domain of FRONTEND_URL becomes part of every username, like @alice@shelfy.example.com
# Do not change it once federation is on, or followers on other instances are lost

# Database
# Set it before the first start: changing it later does not change the database password
POSTGRES_PASSWORD=change-me
# Port to reach the database from this machine only, for maintenance
# Change it if another database already uses 5432
POSTGRES_HOST_PORT=5432

# Sign-ups
# true: anyone can create an account
# false: the sign-up page closes, existing accounts keep working
# Create your own account before closing it, then run deploy.sh again after each change
REGISTRATION_OPEN=true

# Sign-in
# Use a long random value, for example from: openssl rand -base64 48
APP_JWT_ACCESS_TOKEN_SECRET=generate-a-long-random-secret
# Optional settings, shown with their default values
# Remove the # at the start of a line to change it
# APP_JWT_ISSUER=shelfy-api
# APP_JWT_AUDIENCE=shelfy-web
# JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
# APP_CORS_ALLOWED_ORIGIN=<FRONTEND_URL>
# PASSWORD_RESET_EXPIRATION_MINUTES=30
# EMAIL_VERIFICATION_EXPIRATION_MINUTES=1440
# EMAIL_CHANGE_EXPIRATION_MINUTES=30
# AVATAR_MAX_SIZE_BYTES=2097152

# Email
# Set to false if you have no email server and leave the SMTP values below empty
# New accounts can then sign in without confirming their email
# Password reset and email change still need an email server
# Turning it back on later asks accounts created meanwhile to confirm their email
EMAIL_VERIFICATION_REQUIRED=true
APP_MAIL_FROM=no-reply@shelfy.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls for port 587, ssl for port 465, none for a local relay without encryption
SMTP_SECURITY=starttls
# Leave the username empty for a server that needs no sign-in
SMTP_USERNAME=no-reply@shelfy.example.com
SMTP_PASSWORD=change-me

# Outside services
# All optional, leave a value empty to turn that service off
# TMDB for films and series, get a token at https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=
# IGDB for video games, create an app at https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Steam for game library import, get a key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Legal notice
# Who runs this instance and who hosts it, shown on the legal notice page
LEGAL_CONTROLLER_NAME=change-me
LEGAL_CONTACT_EMAIL=privacy@change-me.example
LEGAL_JURISDICTION="CNIL (France) — https://www.cnil.fr"
LEGAL_HOSTING_PROVIDER_NAME=change-me
LEGAL_HOSTING_PROVIDER_ADDRESS=change-me
